}

impl Add for vec3 {
    fn add(vec3* other) -> vec3 v {
        v = { x + other.x, y + other.y, z + other.z }; return v;
    }
    fn add(i32 val) -> vec3 v {
        v = {x + val, y + val, z + val}; return v;
    }
    fn add(f32 val) -> vec3 v {
        v = {x + val, y + val, z + val}; return v;
    }
}

impl Sub for vec3 {
    fn sub(vec3* other) -> vec3 v {
        v = {x - other.x, y - other.y, z - other.z}; return v;
    }
    fn sub(i32 val) -> vec3 v {
        v = {x - val, y - val, z - val}; return v;
    }
    fn sub(f32 val) -> vec3 v {
        v = {x - val, y - val, z - val}; return v;
    }
}

impl Mul for vec3 {
    fn mul(i32 scale) -> vec3 v {
        v = { x * scale, y * scale, z * scale }; return v;
    }
    fn mul(f32 scale) -> vec3 v {
        v = { x * scale, y * scale, z * scale }; return v;
    }
}

impl Div for vec3 {
    fn div(i32 scale) -> vec3 v {
        v = {x / scale, y / scale, z / scale }; return v;
    }
    fn div(f32 scale) -> vec3 v {
        v = {x / scale, y / scale, z / scale }; return v;
    }
}

impl Eq for vec3 {
    fn eq(vec3* other) -> bool {
        return x == other.x && y == other.y && z == other.z;
    }
    fn eq(i32 i) -> bool {
        return x == i && y == i && z == i;
    }
    fn eq(f32 i) -> bool {
        return x == i && y == i && z == i;
    }
}

impl Neg for vec3 {
    fn neg() -> vec3 v {
        v = {0 - x, 0 - y, 0 - z}; return v;
    }
}