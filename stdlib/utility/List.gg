module std.utility;

class Node<T> {
    mut T value;
    mut Node<T>&? next;

    Node(T value){
        this.value = value;
        this.next = null;
    }
}

class List<T>  {

    mut i32 size;
    mut Node<T>&? begin;
    mut Node<T>&? end;

    List(){
        size = 0;
        begin = null;
        end = null;
    }

    fn add(T& val) mut {
        if (begin == null){
            begin = new Node<T>(val);
            end = begin;
        } else {
            mut Node<T>&? temp = end;
            end = new Node<T>(val);
            temp.next = end;
        }
        size++;
    }
}


class ListIter<T> {
    mut Node<T>&? pos;
}

impl <T> Iterator for ListIter<T> {
    fn hasNext() -> bool { return pos != null && pos!!.next != null; }
    fn next() mut -> T* {
        T* val = pos!!.next!!.value;
        pos = pos!!.next;
        return val;
    }
}

impl <T> Iterable for List<T> {
    fn iter() -> ListIter<T> it {
        it.pos = begin;
        return it;
    }
}