    fn trim() mut {

    }*/

}



impl Clone for StringBuilder {
    fn clone(StringBuilder& src) mut {
        free(this.data);
        this.size = src.size;
        u64 allocSize = this.size + 1;
        this.data = malloc(allocSize);
        memcpy(this.data, src.data, allocSize);
    }
}
