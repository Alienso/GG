module std.math;

import std.crt;

class Math{

    static f64 E = 2.7182818284590452354;
    static f64 PI = 3.14159265358979323846;

    fn static sin(f64 x) -> f64 {
        return sin(x);
    }
    fn static cos(f64 x) -> f64 {
        return cos(x);
    }
    fn static tan(f64 x) -> f64 {
        return tan(x);
    }
    fn static asin(f64 x) -> f64 {
        return asin(x);
    }
    fn static acos(f64 x) -> f64 {
        return acos(x);
    }
    fn static atan(f64 x) -> f64 {
        return atan(x);
    }
    fn static atan2(f64 y, f64 x) -> f64 {
        return atan2(y, x);
    }
    fn static sqrt(f64 x) -> f64 {
        return sqrt(x);
    }
    fn static cbrt(f64 x) -> f64 {
        return cbrt(x);
    }
    fn static pow(f64 base, f64 exp) -> f64 {
        return pow(base, exp);
    }
    fn static exp(f64 x) -> f64 {
        return exp(x);
    }
    fn static log(f64 x) -> f64 {
        return log(x);
    }
    fn static log2(f64 x) -> f64 {
        return log2(x);
    }
    fn static log10(f64 x) -> f64 {
        return log10(x);
    }
    fn static floor(f64 x) -> f64 {
        return floor(x);
    }
    fn static ceil(f64 x) -> f64 {
        return ceil(x);
    }
    fn static round(f64 x) -> f64 {
        return round(x);
    }
    fn static fmod(f64 x, f64 y) -> f64 {
        return fmod(x, y);
    }
    fn static fmin(f64 x, f64 y) -> f64 {
        return fmin(x, y);
    }
    fn static fmax(f64 x, f64 y) -> f64 {
        return fmax(x, y);
    }
    fn static abs(f64 x) -> f64 {
         return fabs(x);
    }
    fn static abs(f32 x) -> f32 {
         return fabsf(x);
    }
    fn static abs(i64 x) -> i64 {
         return labs(x);
    }
    fn static abs(i32 x) -> i32 {
         return abs(x);
    }
    fn static min(i64 x, i64 y) -> i64 {
        return x < y ? x : y;
    }
    fn static min(i32 x, i32 y) -> i32 {
        return x < y ? x : y;
    }
    fn static min(f64 x, f64 y) -> f64 {
        if (x != x) return x;
        if (y != y) return y;
        return x < y ? x : y;
    }
    fn static min(f32 x, f32 y) -> f32 {
        if (x != x) return x;
        if (y != y) return y;
        return x < y ? x : y;
    }

}