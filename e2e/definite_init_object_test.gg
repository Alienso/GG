// e2e/definite_init_object_test.gg — definite initialization now covers Object (class) locals, not
// just primitives/references. A bare `ClassName name;` (no initializer):
//   - class has NO constructor            -> unaffected, zero-init is its complete valid state.
//   - class has a (possibly all-defaulted) zero-arg-callable constructor -> auto-invoked, so the
//     class's own invariant-establishing logic actually runs (this is what fixed a real
//     heap-corruption bug: a generic container's ctor, e.g. Array<T>'s cap/data setup, used to be
//     silently skipped by a bare declaration).
//   - class has ONLY parameterized constructors -> deferred init, exactly like a primitive: any use
//     before an explicit assignment is a compile error, and the single defining assignment (on
//     whichever branch reaches it) constructs directly into the destination — no temp, no clone.
// Exit 0 = all checks held.

import std.Array;

class Point { mut i32 x; mut i32 y; }   // ctor-less

class Widget {
    mut i32 v;
    Widget(i32 x) { v = x; }
    Widget(char c) { v = (c as i32) + 1000; }
}

fn pick(bool useInt) -> i32 {
    mut Widget w;                         // no zero-arg ctor -> deferred init
    if (useInt) { w = Widget(42); } else { w = Widget('a'); }
    return w.v;
}

fn main() -> i32 {
    // ctor-less class: bare declaration + immediate field writes, unaffected.
    mut Point p;
    p.x = 5; p.y = 7;
    if (p.x + p.y != 12) { return 1; }

    // Zero-arg-ctor class (Array<T>): bare declaration now auto-invokes the constructor, so
    // grow()/emplaceBack work correctly instead of corrupting memory.
    mut Array<i32> a;
    mut i32 i = 0;
    while (i < 20) { a.emplaceBack(i); i = i + 1; }
    if (a.size() != 20 || a.get(19) != 19) { return 2; }

    // Deferred init + direct-construct-per-branch, no default-construction overhead.
    if (pick(true) != 42) { return 3; }
    if (pick(false) != 1097) { return 4; }   // 'a' = 97 -> 97 + 1000

    return 0;
}
