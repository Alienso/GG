// TODO private
fn print(str s, i32 begin, i32 end){
    for (mut i32 i = begin; i < end; i++){ //bounds check?
        putchar(s[i]);
    }
}

fn print(str s, i32 begin){
    for (mut i32 i = begin; i < s.len; i++){ //bounds check?
        putchar(s[i]);
    }
}

