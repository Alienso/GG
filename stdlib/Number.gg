module std;

import std.crt;

class Integer {

    static i8 MIN_I8 =  -128;
    static i8 MAX_I8 =  127;
    static u8 MAX_U8 =  255;

    static i16 MIN_I16 =  -32768;
    static i16 MAX_I16 =  32767;
    static u16 MAX_U16 =  65535;

    static i32 MIN_I32 = -2147483648;
    static i32 MAX_I32 =  2147483647;
    static u32 MAX_U32 =  4294967295;

    static i64 MIN_I64 = -9223372036854775808;
    static i64 MAX_I64 = 9223372036854775807;
    static u64 MAX_U64 = 18446744073709551615;
}


// NOTE: for T = i64, an input that genuinely overflows i64 is silently clamped by strtoll to
// i64::MIN/MAX (no errno check here), so it is NOT detected as out-of-range — only i8/i16/i32 get
// a real independent overflow check, since their bounds are strictly narrower than i64's.
fn parseInt<T>(str s, T min, T max) -> T? {
    ptr end = 0 as ptr;
    i64 res = strtoll(s.data, addressOf(end), 0);
    if (end == s.data) {
        return null;
    }
    ptr<u8> endBytes = end;
    if (endBytes[0] != 0) {
        return null;
    }
    if (res < min || res > max) {
        return null;
    }
    return res as T;
}


fn parseUInt<T>(str s, T max) -> T? {
    if (s.len == 0) {
        return null;
    }
    if (s[0] == '-') {
        return null;   // unsigned cannot be negative; strtoull would otherwise wrap around
    }
    ptr end = 0 as ptr;
    u64 res = strtoull(s.data, addressOf(end), 0);
    if (end == s.data) {
        return null;
    }
    ptr<u8> endBytes = end;
    if (endBytes[0] != 0) {
        return null;
    }
    if (res > max) {
        return null;
    }
    return res as T;
}

fn parseI32(str s) -> i32? {
    return parseInt<i32>(s, Integer.MIN_I32, Integer.MAX_I32);
}

fn parseI64(str s) -> i64? {
    return parseInt<i64>(s, Integer.MIN_I64, Integer.MAX_I64);
}

fn parseI8(str s) -> i8? {
    return parseInt<i8>(s, Integer.MIN_I8, Integer.MAX_I8);
}

fn parseI16(str s) -> i16? {
    return parseInt<i16>(s, Integer.MIN_I16, Integer.MAX_I16);
}

fn parseU8(str s) -> u8? {
    return parseUInt<u8>(s, Integer.MAX_U8);
}

fn parseU16(str s) -> u16? {
    return parseUInt<u16>(s, Integer.MAX_U16);
}

fn parseU32(str s) -> u32? {
    return parseUInt<u32>(s, Integer.MAX_U32);
}

fn parseU64(str s) -> u64? {
    return parseUInt<u64>(s, Integer.MAX_U64);
}

fn parseF32(str s) -> f32? {
    ptr end = 0 as ptr;
    f32 res = strtof(s.data, addressOf(end));
    if (end == s.data) {
        return null;
    }
    ptr<u8> endBytes = end;
    if (endBytes[0] != 0) {
        return null;
    }
    return res;
}

fn parseF64(str s) -> f64? {
    ptr end = 0 as ptr;
    f64 res = strtod(s.data, addressOf(end));
    if (end == s.data) {
        return null;
    }
    ptr<u8> endBytes = end;
    if (endBytes[0] != 0) {
        return null;
    }
    return res;
}