// End-to-end: RAII read/write guards over a `RwLock<T>` (concurrency Phase 2.5), single-threaded
// coverage of auto-deref through both guard kinds.
//
// `rw.wlock()` → a `RwWriteGuard` granting mutable auto-deref access; `rw.rlock()` → a `RwReadGuard`
// granting read-only auto-deref access. Each guard releases its matching lock mode at scope exit.
import std.sync.RwLock;
import std.sync.RwReadGuard;
import std.sync.RwWriteGuard;

class Data {
    mut i32 v;
    Data() { v = 0; }
    fn set(i32 x) mut { v = x; }
    fn get() -> i32 { return v; }
}

fn main() -> i32 {
    RwLock<Data> rw = RwLock<Data>(Data());

    {
        RwWriteGuard<Data> w = rw.wlock();
        w.v = 40;         // auto-deref field write (exclusive)
        w.set(w.get() + 2);   // auto-deref mut method + read-only method
    }

    mut i32 seen = 0;
    {
        RwReadGuard<Data> r = rw.rlock();
        seen = r.get();   // auto-deref read-only method (shared)
    }

    if (seen == 42) { return 42; }
    return 1;
}
