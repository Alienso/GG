module std;

import std.crt;

class String {
    private mut ptr data;
    private mut u64 size;

    String(str literal) {
        this.size = literal.len;
        u64 allocSize = this.size + 1;
        this.data = malloc(allocSize);
        memcpy(this.data, literal.data, allocSize);
    }

    ~String() {
        free(this.data);
    }

    // ---- size / emptiness ----

    // Number of Unicode codepoints
    fn length() -> u64 {
        ptr<u8> bytes = this.data;
        mut u64 count = 0;
        mut u64 i = 0;
        while (i < this.size) {
            u8 b = bytes[i];
            if ((b & 192) != 128) {             // 192 = 11000000, 128 = 10000000
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    fn byteLength() -> u64 {
        return this.size;
    }

    fn isEmpty() -> bool {
        return this.size == 0;
    }

    // True if the string is empty or contains only ASCII whitespace
    fn isBlank() -> bool {
        ptr<u8> bytes = this.data;
        mut u64 i = 0;
        while (i < this.size) {
            u8 c = bytes[i];
            // space, tab, LF, VT, FF, CR
            if (c != 32 && c != 9 && c != 10 && c != 11 && c != 12 && c != 13) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    // ---- element access ----

    fn charAt(u64 index) -> char {
        ptr<u8> bytes = this.data;
        mut u64 cpIndex = 0;
        mut u64 i = 0;
        while (i < this.size) {
            u8 lead = bytes[i];

            mut u64 len = 1;
            if ((lead & 128) == 0)        { len = 1; }   // 0xxxxxxx
            else if ((lead & 224) == 192) { len = 2; }   // 110xxxxx
            else if ((lead & 240) == 224) { len = 3; }   // 1110xxxx
            else if ((lead & 248) == 240) { len = 4; }   // 11110xxx

            if (cpIndex == index) {
                if (len == 1) {
                    return lead as char;
                }
                // Widen each byte to i32 BEFORE the shifts: GG has no integer promotion,
                // so a u8 operand keeps the arithmetic 8-bit and any shift >= 8 (or a
                // 2-byte lead >= U+00C0) silently overflows to 0. Casting first keeps the
                // whole decode in i32 width.
                if (len == 2) {
                    i32 cp = (((lead as i32) & 31) << 6)
                           |  ((bytes[i + 1] as i32) & 63);
                    return cp as char;
                }
                if (len == 3) {
                    i32 cp = (((lead as i32) & 15) << 12)
                           | (((bytes[i + 1] as i32) & 63) << 6)
                           |  ((bytes[i + 2] as i32) & 63);
                    return cp as char;
                }
                i32 cp = (((lead as i32) & 7) << 18)
                       | (((bytes[i + 1] as i32) & 63) << 12)
                       | (((bytes[i + 2] as i32) & 63) << 6)
                       |  ((bytes[i + 3] as i32) & 63);
                return cp as char;
            }

            cpIndex = cpIndex + 1;
            i = i + len;
        }
        return -1;
        //abort(); TODO when using this compiler throws an error:
        // method 'charAt' does not always return a value
    }

    // The raw byte at position `i` (byte index, not codepoint). No bounds check.
    fn byteAt(u64 i) -> u8 {
        ptr<u8> bytes = this.data;
        return bytes[i];
    }

    // ---- comparison ----

    fn equals(String& other) -> bool {
        return strcmp(this.data, other.data) == 0;
    }

    // Lexicographic (by codepoint) comparison: <0 if this < other, 0 if equal, >0 if
    // this > other. Byte comparison of UTF-8 preserves codepoint order.
    fn compareTo(String& other) -> i32 {
        return strcmp(this.data, other.data);
    }

    // ---- searching ----

    fn startsWith(String& prefix) -> bool {
        if (prefix.size > this.size) { return false; }
        return strncmp(this.data, prefix.data, prefix.size) == 0;
    }

    fn endsWith(String& suffix) -> bool {
        if (suffix.size > this.size) { return false; }
        ptr<u8> a = this.data;
        ptr<u8> b = suffix.data;
        u64 off = this.size - suffix.size;
        mut u64 k = 0;
        while (k < suffix.size) {
            if (a[off + k] != b[k]) { return false; }
            k = k + 1;
        }
        return true;
    }

    fn contains(String& needle) -> bool {
        return this.byteIndexOf(needle) != null;
    }

    // Codepoint index of the first occurrence of `needle`
    fn indexOf(String& needle) -> i64? {
        i64? byteOff = this.byteIndexOf(needle);
        if (byteOff == null) { return null; }
        ptr<u8> bytes = this.data;
        u64 limit = byteOff as u64;
        mut u64 count = 0;
        mut u64 i = 0;
        while (i < limit) {
            u8 b = bytes[i];
            if ((b & 192) != 128) { count = count + 1; }
            i = i + 1;
        }
        return count as i64?;
    }

    fn lastIndexOf(String& needle) -> i64? {
    return null;
    }

    // ---- private internals (touch `ptr`; not part of the public interface) ----

    // Byte offset of the first occurrence of `needle`
    fn private byteIndexOf(String& needle) -> i64? {
        if (needle.size == 0) { return 0; }
        if (needle.size > this.size) { return -1; }
        ptr<u8> h = this.data;
        ptr<u8> n = needle.data;
        u64 last = this.size - needle.size;
        mut u64 i = 0;
        while (i <= last) {
            mut u64 j = 0;
            mut bool matched = true;
            while (j < needle.size) {
                if (h[i + j] != n[j]) { matched = false; break; }
                j = j + 1;
            }
            if (matched) { return i as i64; }
            i = i + 1;
        }
        return null;
    }

    // The underlying null-terminated buffer
    fn cStr() -> ptr {
        return this.data;
    }


    /*fn subString() -> String s {

    }

    fn split() -> Array<String> strings {

    }


    fn isAlpha() -> bool {

    }

    fn isNumeric() -> bool {

    }

    fn isAlphaNumeric() -> bool {

    }

    fn compareIgnoreCase() -> i32 {

    }*/
}


impl Eq for String {
    fn eq(String& other) -> bool { return this.equals(other); }
}
impl Ord for String {
    fn cmp(String& other) -> i32 { return this.compareTo(other); }
}

impl Clone for String {
    fn clone(String& src) mut {
        free(this.data);
        this.size = src.size;
        u64 allocSize = this.size + 1;
        this.data = malloc(allocSize);
        memcpy(this.data, src.data, allocSize);
    }
}
