// End-to-end: an OS thread mutating captured shared state, joined, with a BALANCED refcount.
//
// `Thread.create(closure)` (stdlib `std.thread`) spawns a thread; the closure is heap-copied and
// owned solely by that thread, which releases it when done. A captured `Shared<T>` is retained
// atomically on capture and released atomically by whichever thread drops the last handle — so the
// wrapped object is destroyed exactly once even though main and the spawned thread race on the count.
//
// Tracker counts its own live instances (ctor ++ / dtor --). After the shared handle and the thread
// are both gone, `Tracker::live` must be back to 0 (no leak; a double-free would crash instead).
import std.thread.Thread;

class Tracker {
    mut static i32 live;
    mut i32 val;
    Tracker() { this.val = 0; Tracker::live = Tracker::live + 1; }
    ~Tracker() { Tracker::live = Tracker::live - 1; }
    fn bump() mut { this.val = this.val + 1; }
    fn get() -> i32 { return this.val; }
}

fn main() -> i32 {
    mut i32 observed = 0;
    {
        mut Shared<Tracker> s = Shared<Tracker>();               // born-shared, count 1, live 1
        Thread t = Thread.create(() -> { s.bump(); s.bump(); }); // captures s (atomic retain); spawns
        t.join();                                                 // wait for the two bumps
        observed = s.get();                                       // 2 if the thread ran
    }   // s + t leave scope; the thread already dropped its handle, so the last release frees Tracker

    // observed == 2  ⇒ the spawned thread mutated the shared state.
    // Tracker::live == 0 ⇒ the shared object was released exactly once (no leak, no double free).
    if (observed == 2 && Tracker::live == 0) { return 42; }
    return 1;
}
