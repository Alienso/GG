import "std/crt/cio.gg";
import "std/crt/cmem.gg";
import "std/crt/cstring.gg";

import "std/array.gg";
import "std/string.gg";
import "std/math.gg";

import "std/io.gg";

class Instance{
    i32 x;
    i32 y;

    static mut i32 nextId = 0;
    i32 id;

    Instance(i32 x, i32 y){
        this.x = x;
        this.y = y;

        this.id = Instance::nextId;
        nextId++;
        print("Instance #"); print(id); println(" created!");
    }

    ~Instance(){
        print("Instance #"); print(id); println(" destroyed!");
    }
}

fn main() -> i32 {

    Instance i = new Instance(1, 2);
    Array<Instance> array();
    array.emplaceBack(1,2);

    return 0;
}

