// End-to-end: RAII lock guards over `Shared<Mutex<T>>` (concurrency Phase 2.5).
//
// The counterpart to e2e/mutex_test.gg's closure form: instead of `.with(p -> {...})`, each thread
// acquires a `MutexGuard<Counter>` and mutates the interior by AUTO-DEREF (`g.bump()`), letting the
// guard's destructor release the lock at the end of the inner scope. Two threads each increment 1000
// times → the lock serialises them → deterministic 2000, and the shared handle is released exactly
// once (Counter::live back to 0).
import std.thread.Thread;
import std.sync.Mutex;
import std.sync.MutexGuard;

class Counter {
    mut static i32 live;
    mut i32 n;
    Counter() { n = 0; Counter::live = Counter::live + 1; }
    ~Counter() { Counter::live = Counter::live - 1; }
    fn bump() mut { n = n + 1; }
    fn get() -> i32 { return n; }
}
// The Mutex clones the ctor argument into its interior; count that clone as a live instance.
impl Clone for Counter { fn clone(Counter& src) mut { n = src.n; Counter::live = Counter::live + 1; } }
class G { mut static i32 total; }

fn worker(Shared<Mutex<Counter>> c) {
    mut i32 i = 0;
    while (i < 1000) {
        {
            MutexGuard<Counter> g = c.lock();   // acquire; g.dtor unlocks at the block's end
            g.bump();                            // auto-deref: mutate the guarded interior in place
        }
        i = i + 1;
    }
}

fn main() -> i32 {
    {
        Shared<Mutex<Counter>> counter = Shared<Mutex<Counter>>(Counter());
        Thread t1 = Thread.create(() -> { worker(counter); });
        Thread t2 = Thread.create(() -> { worker(counter); });
        t1.join();
        t2.join();
        {
            MutexGuard<Counter> g = counter.lock();
            G::total = g.get();                  // auto-deref: read the final value under the lock
        }
    }   // counter + its Mutex<Counter> leave scope → ~Counter runs → live back to 0

    if (G::total == 2000 && Counter::live == 0) { return 42; }
    return 1;
}
