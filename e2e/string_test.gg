// e2e/string_test.gg — exercises the stdlib String class (UTF-8 aware, Java-like API).
// Returns a unique number on the first failing check; 0 on success.

import std.String;

fn main() -> i32 {
    // "café" = c a f é  →  5 bytes (é is 2 bytes), 4 codepoints.
    String s("café");
    if (s.byteLength() != 5) { return 1; }
    if (s.length()     != 4) { return 2; }
    if (s.isEmpty())         { return 3; }

    // Empty string.
    String empty("");
    if (!empty.isEmpty())    { return 4; }
    if (empty.length() != 0) { return 5; }

    // byteAt — 'c' is ASCII 99.
    if (s.byteAt(0) != 99)   { return 6; }

    // charAt — ASCII and non-ASCII codepoints.
    if (s.charAt(0) != 99)   { return 7; }   // 'c'
    if (s.charAt(2) != 102)  { return 8; }   // 'f'
    if (s.charAt(3) != 233)  { return 9; }   // 'é' = U+00E9 = 233

    // A 3-byte codepoint: "✓" = U+2713 = 10003.
    String check("✓");
    if (check.byteLength() != 3)  { return 10; }
    if (check.length()     != 1)  { return 11; }
    if (check.charAt(0)    != 10003) { return 12; }

    // Equality via the Eq impl (== / !=).
    String a("hello");
    String b("hello");
    String c("world");
    if (!(a == b)) { return 13; }
    if (a == c)    { return 14; }
    if (a != b)    { return 15; }

    // equals() method.
    if (!a.equals(b))          { return 16; }
    if (a.equals(c))           { return 17; }

    // isBlank.
    String spaces("   ");
    if (!spaces.isBlank())     { return 18; }
    if (a.isBlank())           { return 19; }

    // Ordering — compareTo + the Ord operators.
    if (a.compareTo(c) >= 0)   { return 20; }   // "hello" < "world"
    if (c.compareTo(a) <= 0)   { return 21; }
    if (a.compareTo(b) != 0)   { return 22; }
    if (!(a < c))              { return 23; }
    if (!(c > a))              { return 24; }

    // startsWith / endsWith.
    String hello("hello world");
    String he("hello");
    String ld("world");
    String big("hello world!!!");
    if (!hello.startsWith(he)) { return 25; }
    if (hello.startsWith(big)) { return 26; }   // prefix longer than string
    if (!hello.endsWith(ld))   { return 27; }
    if (hello.endsWith(big))   { return 28; }

    // contains / indexOf.
    String lo("lo w");
    String zz("zzz");
    if (!hello.contains(lo))   { return 29; }
    if (hello.contains(zz))    { return 30; }
    if (hello.indexOf(ld) != 6)  { return 31; }   // "world" starts at codepoint 6
    if (hello.indexOf(zz) != -1) { return 32; }

    return 0;
}
