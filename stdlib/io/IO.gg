module std.io;

import std.crt;

fn printf<...Ts> (str* formatString, Ts... args) {
    printInternal(formatString, 0, args...);
}

fn private printInternal<...Ts> (str* formatString, mut i32 cursor, Ts... args) {
    match args {
            ()     -> { printStr(formatString, cursor); }
            (x:xs) -> {
                i32 begin = cursor;
                cursor = nextPlaceholder(formatString, cursor);
                printStr(formatString, begin, cursor - 1);   // text before the placeholder (or the
                                                              // whole rest of the string if none left)
                print(x);
                printInternal(formatString, cursor + 2, xs...);
            }
        }
}

fn private nextPlaceholder(str* s, i32 from) -> i32 {
    i32 len = s.len as i32;
    mut i32 i = from;
    while (i < len) {
        if (s[i] == '\\' && i + 1 < len && s[i + 1] == '{') {
            i = i + 2;      // skip the escaped brace — not a placeholder
            continue;
        }
        if (s[i] == '{' && i + 1 < len && s[i + 1] == '}') {
            return i;
        }
        i = i + 1;
    }
    return len;
}

// Inclusive range [begin, end]
fn private printStr(str* s, i32 begin, i32 end){
    if (begin < 0 || begin > end ) { return; }   // empty range (e.g. more args than placeholders) — nothing to print
    u64 base = (s.data as u64) + (begin as u64);
    if (end > (s.len as i32) )
        fwrite(base as ptr, 1, (s.len - begin) as u64, gg_stdout());
    else fwrite(base as ptr, 1, (end - begin + 1) as u64, gg_stdout());
}

// inclusive [begin, len]
fn private printStr(str* s, i32 begin){
    printStr(s, begin, (s.len as i32) - 1);
}