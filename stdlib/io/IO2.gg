module std.io;

import std.crt;

import "std/io/IO.gg";

fn printx<...Ts> (str* formatString, Ts... args) {
    printf(formatString, 0, args...);
}

// TODO private
fn printf<...Ts> (str* formatString, mut i32 cursor, Ts... args) {
    match args {
            ()     -> { printInternal(formatString, cursor); }
            (x:xs) -> {
                i32 begin = cursor;
                while (formatString[cursor] != '{' && cursor < formatString.len) {
                   cursor++;
                }
                printInternal(formatString, begin, cursor);
                print(x);
                printf(formatString, cursor + 2, xs...);
            }
        }
}

// TODO private
fn printInternal(str* s, i32 begin, i32 end){
    for (mut i32 i = begin; i < end; i++){ //bounds check?
        putchar(s[i] as i32);
    }
}

fn printInternal(str* s, i32 begin){
    for (mut i32 i = begin; i < s.len; i++){ //bounds check?
        putchar(s[i] as i32);
    }
}

fn print(str* s) {
    fputs(s.data, gg_stdout());
}