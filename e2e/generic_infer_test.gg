// Generic type-argument DEDUCTION: `f(x)` inferring `f<T>(x)` from the argument's type.
class Box { mut i32 v; Box(i32 x) { this.v = x; } }
enum Color { RED, GREEN, BLUE }

fn unwrap<T>(T& b) -> i32 { return b.v; }          // T inferred from an object reference arg
fn idOf<T>(T c) -> i32 {                            // T inferred from an enum value arg
    if (c == Color::GREEN) { return 1; }
    return 0;
}
fn take<T>(T& b) -> i32 { return b.v + 100; }      // fed a `new` / constructor rvalue

fn main() -> i32 {
    mut Box b = Box(7);
    Box& h = new Box(9);
    Color g = Color::GREEN;
    mut i32 acc = 0;

    acc = acc + unwrap(b);          // identifier: b : Box       -> unwrap<Box>   = 7
    acc = acc + unwrap(h);          // identifier: h : Box&      -> unwrap<Box>   = 9
    acc = acc + idOf(g);            // identifier: g : Color     -> idOf<Color>   = 1
    acc = acc + take(Box(3));       // constructor rvalue        -> take<Box>     = 103
    acc = acc + take(new Box(4));   // new-expression            -> take<Box>     = 104

    if (acc == 224) { return 0; }   // 7 + 9 + 1 + 103 + 104
    return acc;
}
