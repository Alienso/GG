{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GG",
  "scopeName": "source.gg",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#declarations" },
    { "include": "#reflection" },
    { "include": "#keywords" },
    { "include": "#modifiers" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#language-variables" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.gg",
          "match": "//.*$"
        },
        {
          "name": "comment.block.gg",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.gg",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.gg", "match": "\\\\." }
      ]
    },
    "chars": {
      "name": "string.quoted.single.gg",
      "match": "'(\\\\.|[^'\\\\])'"
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.gg" },
            "2": { "name": "entity.name.function.gg" }
          }
        },
        {
          "match": "\\b(class|enum|trait)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.gg" },
            "2": { "name": "entity.name.type.gg" }
          }
        },
        {
          "match": "\\b(impl)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.impl.gg" },
            "2": { "name": "entity.name.type.gg" }
          }
        },
        {
          "match": "\\b(new)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.new.gg" },
            "2": { "name": "entity.name.type.gg" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.gg",
          "match": "\\b(if|else|for|while|switch|match|case|default|yield|return|break|continue|inline|in)\\b"
        },
        {
          "name": "keyword.declaration.gg",
          "match": "\\b(fn|class|enum|trait|impl|annotation|module|extern|import|new|static|private|var|super)\\b"
        }
      ]
    },
    "reflection": {
      "comment": "Compile-time reflection builtins: @fields, @field, @variants, @typeName, @fieldCount, @hasField, @offsetOf, @alignOf, @variantCount, @implements, @is*, @compileError, ...",
      "name": "support.function.builtin.reflection.gg",
      "match": "@[A-Za-z_][A-Za-z0-9_]*"
    },
    "modifiers": {
      "name": "storage.modifier.gg",
      "match": "\\b(mut|as|sizeof|destroy)\\b"
    },
    "types": {
      "name": "storage.type.gg",
      "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|char|void|ptr|str|Self)\\b"
    },
    "constants": {
      "name": "constant.language.gg",
      "match": "\\b(true|false|null)\\b"
    },
    "language-variables": {
      "name": "variable.language.this.gg",
      "match": "\\b(this)\\b"
    },
    "numbers": {
      "comment": "Hex (0x/0X) and octal (0o/0O) prefixes, and `_` digit separators anywhere in a run. The lexer validates placement; the grammar just accepts `_` loosely. Octal/hex are listed before decimal so they win at a leading 0.",
      "patterns": [
        { "name": "constant.numeric.hex.gg", "match": "\\b0[xX][0-9a-fA-F_]+\\b" },
        { "name": "constant.numeric.octal.gg", "match": "\\b0[oO][0-7_]+\\b" },
        { "name": "constant.numeric.float.gg", "match": "\\b[0-9][0-9_]*\\.[0-9_]+\\b" },
        { "name": "constant.numeric.integer.gg", "match": "\\b[0-9][0-9_]*\\b" }
      ]
    },
    "operators": {
      "comment": "Order matters: longer/more-specific operators are listed first so they win at a given position (?. before ?, !! before !, << before <, &= before &).",
      "patterns": [
        { "name": "keyword.operator.arrow.gg", "match": "->" },
        { "name": "keyword.operator.scope.gg", "match": "::" },
        { "name": "keyword.operator.nullable.gg", "match": "\\?\\.|\\?:|!!|\\?" },
        { "name": "keyword.operator.bitwise.shift.gg", "match": "<<|>>" },
        { "name": "keyword.operator.comparison.gg", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.logical.gg", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.assignment.gg", "match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|=" },
        { "name": "keyword.operator.arithmetic.gg", "match": "\\+\\+|--|[-+*/%]" },
        { "name": "keyword.operator.bitwise.gg", "match": "[&|^~]" }
      ]
    }
  }
}
