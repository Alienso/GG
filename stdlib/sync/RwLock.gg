module std.sync;

// OS reader/writer-lock primitives. DEFINED by the GG compiler per target platform (Windows: SRWLOCK
// with shared/exclusive modes; POSIX: pthread_rwlock), so this file stays platform-agnostic. The raw
// `ptr` handle is exempt from the --unsafe-ptr gate because this file lives under the stdlib root.
extern gg_rwlock_create() -> ptr;        // allocate + init an OS reader/writer lock; return a handle
extern gg_rwlock_destroy(ptr handle);    // destroy + free it
extern gg_rwlock_rdlock(ptr handle);     // acquire shared (read) — many readers may hold it at once
extern gg_rwlock_rdunlock(ptr handle);   // release a shared (read) hold
extern gg_rwlock_wrlock(ptr handle);     // acquire exclusive (write) — blocks all other readers/writers
extern gg_rwlock_wrunlock(ptr handle);   // release an exclusive (write) hold

// A reader/writer lock: it owns a value of type `T` and allows EITHER many concurrent readers OR one
// exclusive writer. Like `Mutex<T>`, it is the interior-mutability escape hatch that makes
// `Shared<RwLock<T>>` safely shared-and-mutable across threads.
//
// Access is scoped:
//   rw.read(p -> { … })     // shared lock; `p : T*` (read-only) — several threads may read at once
//   rw.write(p -> { … })    // exclusive lock; `p : mut T*` — a single writer
// The borrow is confined to the closure by the compiler (it may not escape). These are
// compiler-recognised forms, not ordinary methods.
//
// A RwLock owns a raw handle + a user destructor, so (like Mutex) it is non-copyable; share it by
// wrapping it in a `Shared<RwLock<T>>`.
class RwLock<T> {
    private mut ptr handle;   // the OS reader/writer lock (stdlib is exempt from the raw-ptr gate)
    private T value;          // the guarded interior; only reachable through `.read` / `.write`

    RwLock(T v) {
        handle = gg_rwlock_create();
        value = v;
    }

    ~RwLock() {
        gg_rwlock_destroy(handle);
    }
}

// RAII guards for a `RwLock<T>` (concurrency Phase 2.5), the counterpart to `Mutex`'s `MutexGuard`.
// Obtained from `rw.rlock()` (shared/read) and `rw.wlock()` (exclusive/write) — compiler-recognised
// calls that acquire the lock and wire the guard, releasing the matching mode in the destructor.
// Access is by AUTO-DEREF (`g.field` / `g.method()`): a read guard hands out a READ-ONLY view of the
// interior (mutation is a compile error — use `.wlock()`), a write guard a mutable one. Both are
// non-copyable scoped locals that may not escape their function.
class RwReadGuard<T> {
    private mut ptr handle;    // the OS rwlock handle, for the shared-mode unlock in the destructor
    private T* interior;       // read-only borrow of the guarded value

    ~RwReadGuard() {
        gg_rwlock_rdunlock(handle);
    }
}

class RwWriteGuard<T> {
    private mut ptr handle;    // the OS rwlock handle, for the exclusive-mode unlock in the destructor
    private mut T* interior;   // mutable borrow of the guarded value

    ~RwWriteGuard() {
        gg_rwlock_wrunlock(handle);
    }
}
