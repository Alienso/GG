
class vec3 {
    mut f32 x;
    mut f32 y;
    mut f32 z;

    vec3 (f64 i) {
        this.x = i as f32;
        this.y = i as f32;
        this.z = i as f32;
    }

    vec3 (i32 i) {
        this.x = i as f32;
        this.y = i as f32;
        this.z = i as f32;
    }

    vec3 (f64 x, f64 y, f64 z){
        this.x = x as f32;
        this.y = y as f32;
        this.z = z as f32;
    }

    vec3 (i32 x, i32 y, i32 z){
        this.x = x as f32;
        this.y = y as f32;
        this.z = z as f32;
    }

    vec3 (vec2 v, i32 z){
        this.x = v.x;
        this.y = v.y;
        this.z = z;
    }

    vec3 (vec2 v, f32 z){
        this.x = v.x;
        this.y = v.y;
        this.z = z;
    }

