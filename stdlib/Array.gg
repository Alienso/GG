module std;

import std.crt;

class Array<T> {
    private mut ptr<T> data;
    private mut u64    count;  // number of elements in use
    private mut u64    cap;    // number of slots allocated

    Array() {
        count = 0;
        cap   = 8;
        data  = calloc(cap, sizeof(T));
        //for (mut i32 i = 0; i < )
    }

    ~Array() {
        mut u64 i = 0;
        while (i < count) { destroy(data[i]); i = i + 1; }   // run each live element's dtor
        free(data);
    }

    // ---- size / capacity ----

    fn size() -> u64 {
        return count;
    }

    fn capacity() -> u64 {
        return cap;
    }

    fn isEmpty() -> bool {
        return count == 0;
    }

    // Whether any element equals `value`. Comparison is plain `==`, so it follows T's own equality
    // rules: an `Eq` impl if T has one, else address identity for a class without one, else the
    // built-in numeric/enum-identity rules for a primitive/enum T.
    fn contains(T* value) -> bool {
        mut u64 i = 0;
        while (i < count) {
            if (value == data[i]) { return true; }
            i = i + 1;
        }
        return false;
    }

    // Append a copy of `value` to the end
    fn pushBack(T* value) mut {
        if (count == cap) {
            grow();
        }
        data[count] = value;
        count = count + 1;
    }

    // Append a new value to the end (constructed in place)
    fn emplaceBack<...Ts> (Ts... args) mut {
        if (count == cap) {
            grow();
        }
        data[count] = T(args...);
        count++;
    }

    // Add a copy of `value` at position pos, shifting elements [pos, count) one slot to the right.
    fn push(i32 pos, T* value) mut {
        if (pos < 0 || (pos as u64) > count) { abort(); }
        if (count == cap) {
            grow();
        }
        mut u64 target = pos as u64;
        mut u64 i = count;
        while (i > target) {
            data[i] = data[i - 1];
            destroy(data[i - 1]);
            i = i - 1;
        }
        data[pos] = value;
        count = count + 1;
    }

    fn pushAll<U: Iterable>(U collection) mut {
        for (T* elem : collection) { pushBack(elem); }
    }

    // Add a new value to position pos (constructed in place), shifting elements [pos, count) right.
    fn emplace<...Ts> (i32 pos, Ts... args) mut {
        if (pos < 0 || (pos as u64) > count) { abort(); }
        if (count == cap) {
            grow();
        }
        mut u64 target = pos as u64;
        mut u64 i = count;
        while (i > target) {
            data[i] = data[i - 1];
            destroy(data[i - 1]);
            i = i - 1;
        }
        data[pos] = T(args...);
        count++;
    }

    // Remove and return the last element.
    fn popBack() mut -> T out {
        if (count == 0){
            abort();
        }
        count = count - 1;
        out = data[count];
        destroy(data[count]);
    }

    // Remove and return the element at position pos, shifting elements (pos, count) one slot left.
    fn pop(i32 pos) mut -> T out {
        if (pos < 0 || (pos as u64) >= count) { abort(); }
        mut u64 target = pos as u64;
        out = data[target];
        destroy(data[target]);
        mut u64 i = target;
        while (i + 1 < count) {
            data[i] = data[i + 1];
            destroy(data[i + 1]);
            i = i + 1;
        }
        count = count - 1;
    }

    // Remove the element at position pos (destroyed, not returned), shifting the tail left.
    fn delete(i32 pos) mut {
        if (pos < 0 || (pos as u64) >= count) { abort(); }
        mut u64 target = pos as u64;
        destroy(data[target]);
        mut u64 i = target;
        while (i + 1 < count) {
            data[i] = data[i + 1];
            destroy(data[i + 1]);
            i = i + 1;
        }
        count = count - 1;
    }

    // Destroy all elements (retains the allocated capacity).
    fn clear() mut {
        mut u64 i = 0;
        while (i < count) { destroy(data[i]); i = i + 1; }
        count = 0;
    }

    // Reserve memory for minCap elements
    fn reserve(u64 minCap) mut {
        if (minCap > cap) {
            cap  = minCap;
            data = realloc(data, cap * sizeof(T));
        }
    }

    // Double the capacity (used when a push overflows the buffer).
    fn private grow() mut {
        cap  = cap * 2;
        data = realloc(data, cap * sizeof(T));
    }
}



class ArrayIter<T> {
    mut Array<T>* arr;
    mut i32       pos;
}

impl <T> Iterator for ArrayIter<T> {
    fn hasNext() -> bool { return pos < arr.size(); }
    fn next() mut -> T* {
        T* e = arr.get(pos);
        pos = pos + 1;
        return e;
    }
}

impl <T> Iterable for Array<T> {
    fn iter() -> ArrayIter<T> it {
        it.arr = this;
        it.pos = 0;
    }
}


impl <T> Index for Array<T> {
    fn get(i32 i) -> T* {
        if (i < 0 || i > count) abort();
        return data[i];
    }
    fn set(i32 i, T* value) mut {
        destroy(data[i]);
        data[i] = value;
    }
}

impl <T> Clone for Array<T> {
    fn clone(Array<T>& src) mut {
        mut u64 i = 0;
        while (i < count) { destroy(data[i]); i = i + 1; }
        free(data);
        count = src.count;
        cap   = src.cap;
        data  = malloc(cap * sizeof(T));
        mut u64 j = 0;
        while (j < src.count) { data[j] = src.data[j]; j = j + 1; }
    }
}
