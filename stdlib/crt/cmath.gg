// stdlib/math.gg — mathematical function bindings
//
// Wraps the standard math functions from <math.h>.
// All functions operate on f64 (double precision).

extern sin(f64 x) -> f64;
extern cos(f64 x) -> f64;
extern tan(f64 x) -> f64;
extern asin(f64 x) -> f64;
extern acos(f64 x) -> f64;
extern atan(f64 x) -> f64;
extern atan2(f64 y, f64 x) -> f64;
extern sqrt(f64 x) -> f64;
extern cbrt(f64 x) -> f64;
extern pow(f64 base, f64 exp) -> f64;
extern exp(f64 x) -> f64;
extern log(f64 x) -> f64;
extern log2(f64 x) -> f64;
extern log10(f64 x) -> f64;
extern fabs(f64 x) -> f64;
extern floor(f64 x) -> f64;
extern ceil(f64 x) -> f64;
extern round(f64 x) -> f64;
extern fmod(f64 x, f64 y) -> f64;
extern fmin(f64 x, f64 y) -> f64;
extern fmax(f64 x, f64 y) -> f64;
extern abs(i32 x) -> i32;
extern labs(i64 x) -> i64;
extern fbs(f64 x) -> f64;
extern fabsf(f32 x) -> f32;
