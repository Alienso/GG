import "std/math/number.gg";
import "std/math/vector.gg";

import "std/io.gg";

class Instance{
    i32 x;
    i32 y;

    static mut i32 nextId = 0;
    i32 id;

    Instance(i32 x, i32 y){
        this.x = x;
        this.y = y;

        this.id = Instance::nextId;
        nextId++;
        print("Instance #"); print(id); println(" created!");
    }

    ~Instance(){
        print("Instance #"); print(id); println(" destroyed!");
    }
}

fn main() -> i32 {

    vec2 v1{1, 5.0};
    vec2 v2{2, 3};

    vec2 v3 = v1 + v2;
    print(v3);

    vec2 v4 = v3 + 1.0;
    print(v4);

    return 0;
}

