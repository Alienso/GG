
class Integer {

    static i32 MIN_VALUE = -2147483648;
    static i32 MAX_VALUE =  2147483647;

    fn static parseInt(str s) -> i32? {

        mut i32 result = 0;
        mut bool negative = false;
        mut i32 i = 0;
        i32 len = s.len as i32;
        mut i32 limit = -Integer.MAX_VALUE;
        mut i32 multmin;
        mut i32 digit;

        if (len > 0) {
            char firstChar = s[0];
            if (firstChar < '0') { // Possible leading "+" or "-"
                if (firstChar == '-') {
                    negative = true;
                    limit = Integer.MIN_VALUE;
                } else if (firstChar != '+')
                    return null;

                if (len == 1) // Cannot have lone "+" or "-"
                    return null;
                i++;
            }
            multmin = limit / 10;
            while (i < len) {
                // Accumulating negatively avoids surprises near MAX_VALUE
                digit = (s[i++] as i32) - 48;
                if (digit < 0) {
                    return null;
                }
                if (result < multmin) {
                    return null;
                }
                result *= 10;
                if (result < limit + digit) {
                    return null;
                }
                result -= digit;
            }
        } else {
            return null;
        }

        if (negative){
            return result;
        }
        return -result;
    }
}