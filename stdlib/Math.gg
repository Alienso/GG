
class Integer {

    static i8 MIN_I8 =  -128;
    static i8 MAX_I8 =  127;
    static u8 MAX_U8 =  255;

    static i16 MIN_I16 =  -32768;
    static i16 MAX_I16 =  32767;
    static u16 MAX_U16 =  65535;

    static i32 MIN_I32 = -2147483648;
    static i32 MAX_I32 =  2147483647;
    static u32 MAX_U32 =  4294967295;

    static i64 MIN_I64 = -9223372036854775808;
    static i64 MAX_I64 = 9223372036854775807;
    static u64 MAX_U64 = 18446744073709551615;
}


fn parseInt<T>(str s, T limit) -> T? {

    i32 len = s.len as i32;
    if (len <= 0) {
        return null;
    }

    bool negative;
    if (s[0] == '-'){
        negative = true;
    } else {
        negative = false;
    }

    mut i32 i = 0;
    mut i8 digit;
    mut T result = 0;
    mut T multmin;

    if (len > 0) {
        char firstChar = s[0];
        if (firstChar < '0') { // Possible leading "+" or "-"
            if (firstChar != '-' && firstChar != '+')
                return null;   // some other non-digit character below '0'

            if (len == 1) // Cannot have lone "+" or "-"
                return null;
            i++;               // skip the sign; `negative` was already set from s[0]
        }
        multmin = limit / 10;
        while (i < len) {
            // Accumulating negatively avoids surprises near MAX_VALUE
            digit = (s[i++] as i8) - 48;
            if (digit < 0 || digit > 9) {   // reject any non-digit (below '0' OR above '9')
                return null;
            }
            if (result < multmin) {
                return null;
            }
            result *= 10;
            if (result < limit + digit) {
                return null;
            }
            result -= digit;
        }
    }

    if (negative){
        return result;
    }

    return -result;
}

fn parseUInt<T>(str s, T limit) -> T? {
    i32 len = s.len as i32;
    if (len <= 0) {
        return null;
    }

    mut i32 i = 0;

    if (s[0] == '+') {
        i++;
    } else if (s[0] == '-') {
        return null; // Unsigned cannot be negative
    }

    if (i >= len) {
        return null; // Only sign or empty after sign
    }

    mut T result = 0;
    mut u8 digit;

    while (i < len) {

        digit = (s[i++] as u8) - 48;
        if (digit < 0 || digit > 9) {   // reject any non-digit (below '0' OR above '9')
            return null;
        }

        result *= 10;
        result += digit;
    }

    return result;
}



fn parseI32(str s) -> i32?{
    return parseInt<i32>(s, s[0] == '-' ? Integer.MIN_I32 : -Integer.MIN_I32) as i32?;
}

fn parseI64(str s) -> i64?{
    return parseInt<i64>(s, s[0] == '-' ? Integer.MIN_I64 : -Integer.MIN_I64);
}

fn parseI8(str s) -> i8? {
    return parseInt<i8>(s, s[0] == '-' ? Integer.MIN_I8 : -Integer.MIN_I8) as i8?;
}

fn parseI16(str s) -> i16? {
    return parseInt<i16>(s, s[0] == '-' ? Integer.MIN_I16 : -Integer.MIN_I16) as i16?;
}

fn parseU8(str s) -> u8? {
    return parseUInt<u8>(s, Integer.MAX_U8);
}

fn parseU16(str s) -> u16? {
    return parseUInt<u16>(s, Integer.MAX_U16);
}

fn parseU32(str s) -> u32? {
    return parseUInt<u32>(s, Integer.MAX_U32);
}

fn parseU64(str s) -> u64? {
    return parseUInt<u64>(s, Integer.MAX_U64);
}